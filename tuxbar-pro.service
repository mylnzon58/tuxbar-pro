[Unit]
Description=TuxBar Pro — Dynamic Apple Touch Bar Suite for Linux T2
After=graphical-session.target pipewire.service pipewire-pulse.service
PartOf=graphical-session.target

[Service]
Type=simple
Environment=PYTHONPATH=/opt/tuxbar-pro
ExecStart=/usr/local/bin/tuxbar-pro
Restart=always
RestartSec=2

[Install]
WantedBy=graphical-session.target
